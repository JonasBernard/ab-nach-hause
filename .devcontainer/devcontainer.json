{
  "name": "Mathe-At-Home: Ab nach Hause",

  "build": {
    "dockerfile": "Dockerfile",
    "context": "../",
    "args": {
      "VERSION": "3.11-bullseye",
      "USERNAME": "vscode",
      "USER_UID": "1000",
      "USER_GID": "${localEnv:$USER_UID}" // yes, this should be UID not GID, see https://code.visualstudio.com/remote/advancedcontainers/add-nonroot-user
    }
  },

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.languageServer": "Default"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-vsliveshare.vsliveshare",
        "tomoki1207.pdf"
      ]
    }
  },

  "forwardPorts": [8080],

  "portsAttributes": {
    "8080": {
      "label": "Web Server",
      "onAutoForward": "openBrowser"
    }
  },

  "hostRequirements": {
    "memory": "16gb",
    "storage": "2gb"
  },

  "remoteUser": "vscode",
  "containerUser": "vscode"
}

